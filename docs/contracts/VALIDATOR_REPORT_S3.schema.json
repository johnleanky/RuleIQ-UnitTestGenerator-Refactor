              "TRACE_MISSING",
              "TRACE_INVALID",
              "DECISION_NOT_FINALIZED",
              "ASSERT_MISSING",
              "ASSERT_EXTRA",
              "ASSERT_VALUE_MISMATCH",
              "OMIT_ASSERTED",
              "SIM_MISSING",
              "SIM_SHAPE_INVALID",
              "PARAM_SHAPE_INVALID",
              "ASSERT_BLOCK_INVALID",
              "COUNT_MISMATCH",
              "REASONING_CONTRADICTION",
